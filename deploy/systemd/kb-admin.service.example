# User systemd unit: Streamlit KB admin on localhost only.
# 1. Copy to ~/.config/systemd/user/kb-admin.service
# 2. Replace REPO_ROOT with the absolute path to this git clone (no trailing slash).
# 3. systemctl --user daemon-reload && systemctl --user enable --now kb-admin.service
#
# With Cloudflare Tunnel + Caddy: tunnel → 127.0.0.1:8089 (Basic Auth) → this app on 8501.
# For a system-wide unit, use /etc/systemd/system/ and a dedicated service user.

[Unit]
Description=AI automation KB admin (Streamlit)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=REPO_ROOT
EnvironmentFile=REPO_ROOT/.env
ExecStart=REPO_ROOT/.venv/bin/streamlit run apps/kb_admin/app.py --server.address 127.0.0.1 --server.port 8501
Restart=on-failure

[Install]
WantedBy=default.target
