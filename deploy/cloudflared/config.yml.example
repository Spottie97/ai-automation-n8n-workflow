# Copy to ~/.cloudflared/config.yml (or /etc/cloudflared/config.yml).
# Replace YOUR_TUNNEL_UUID and credentials path after: cloudflared tunnel create kb-admin
#
# Point at the Caddy loopback port (Basic Auth), NOT Streamlit directly — see
# docs/cloudflare-tunnel-kb-admin.md and deploy/caddy/Caddyfile.example

tunnel: YOUR_TUNNEL_UUID
credentials-file: /home/USER/.cloudflared/YOUR_TUNNEL_UUID.json

ingress:
  - hostname: kb.reinhardterasmus.info
    service: http://127.0.0.1:8089
  - service: http_status:404
