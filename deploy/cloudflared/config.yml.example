# Copy to ~/.cloudflared/config.yml (or /etc/cloudflared/config.yml).
# Replace ALL_CAPS placeholders after: cloudflared tunnel create kb-admin
#
# Streamlit must listen ONLY on 127.0.0.1:8501.

tunnel: YOUR_TUNNEL_UUID
credentials-file: /home/USER/.cloudflared/YOUR_TUNNEL_UUID.json

ingress:
  - hostname: kb-admin.example.com
    service: http://127.0.0.1:8501
  - service: http_status:404
