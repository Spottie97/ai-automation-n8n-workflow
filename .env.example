# Copy to .env and adjust. Do not commit .env.
#
# Smoke test (from repo root): python scripts/verify_stack.py
# KB admin GUI (optional): streamlit run apps/kb_admin/app.py
# If set (non-empty), browser UI requires this password before listing/ingest/search/delete.
# KB_ADMIN_PASSWORD=

# Ollama (embeddings)
OLLAMA_HOST=http://172.88.88.245:11434
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# Qdrant REST API — same host as llama/Ollama; two Docker containers on ai-server:
#   - Default for this project: container "qdrant" → http://172.88.88.245:6333 (REST; host 6334 = gRPC)
#   - Separate DB: container "qdrant-farmtours" → http://172.88.88.245:6336 (REST); host 6337 → container gRPC
QDRANT_URL=http://172.88.88.245:6333
# QDRANT_API_KEY=

# Optional: chunking (ingest CLI defaults shown)
# CHUNK_SIZE=600
# CHUNK_OVERLAP=80

# Generation — llama-server (OpenAI-compatible). On ai-server there are two systemd services:
#   - Gemma 4 E4B: llama-server-gemma4.service → http://172.88.88.245:8081  (use this for automation)
#   - Qwen3.5 4B:  llama-server.service         → http://172.88.88.245:8080
LLAMA_SERVER_URL=http://172.88.88.245:8081
# Exact id from GET {LLAMA_SERVER_URL}/v1/models (must match llama-server registration).
# Your GGUF may be ~/models/gemma-4-E4B/gemma-4-E4B-it-Q4_K_M.gguf — on port 8081 the id is typically:
LLAMA_CHAT_MODEL=gemma4-e4b

# n8n — set in n8n (Settings → Variables or container env). Workflows: workflows/rag-email-mvp.json, workflows/rag-whatsapp-mvp.json, workflows/rag-email-whatsapp-mvp.json
# CLIENT_ID=demo_client
# SMTP_FROM=noreply@example.com
# WhatsApp Cloud API: Business phone number ID (Meta Developer → WhatsApp → API Setup); used by send nodes in rag-whatsapp-mvp / rag-email-whatsapp-mvp
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
